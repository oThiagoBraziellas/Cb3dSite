# Copie para .env.local e preencha. Sem as do Supabase o site roda em modo demonstração.

# Endereço final do site (sem barra no fim)
NEXT_PUBLIC_SITE_URL=https://www.cb3d.com.br

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # ou a "anon key" antiga em NEXT_PUBLIC_SUPABASE_ANON_KEY
# Só no servidor (nunca com NEXT_PUBLIC_): usada só pra ler os contatos privados de aviso
SUPABASE_SERVICE_ROLE_KEY=

# Aviso de pedido por e-mail (opcional) → resend.com, plano grátis
RESEND_API_KEY=
RESEND_FROM=CB3D <pedidos@cb3d.com.br>

# Google Analytics 4 (opcional; só carrega depois que a cliente aceita os cookies)
NEXT_PUBLIC_GA_ID=
